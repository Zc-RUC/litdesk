{
  "name": "litdesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "A private, local-first literature workspace",
  "scripts": {
    "dev": "concurrently -k \"node server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "desktop": "electron .",
    "dist:mac": "bash scripts/package-mac.sh",
    "icon:mac": "bash scripts/build-icon.sh",
    "check": "node --check server/index.js && node --check server/db.js && node --check server/library.js && node --check server/pdf.js && node --check server/metadata.js && node --check server/citations.js && node --check server/ai.js && node --check server/metadata-ai.js && node --check server/batch-ai.js && node --check server/integrations.js && node --check server/citation-docx.js && node --check server/wps.js && node --check desktop/main.cjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "chokidar": "^4.0.3",
    "citeproc": "^2.4.63",
    "dompurify": "^3.2.6",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.7",
    "pdfjs-dist": "5.4.149",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "build": {
    "appId": "com.litdesk.desktop",
    "productName": "LitDesk",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "desktop/**/*",
      "package.json",
      "!node_modules/@fontsource/**",
      "!node_modules/lucide-react/**",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/marked/**",
      "!node_modules/dompurify/**"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "extendInfo": {
        "CFBundleDisplayName": "LitDesk",
        "NSAppleEventsUsageDescription": "LitDesk 需要控制 WPS 或 Word，以插入你确认生成的引用。"
      }
    }
  },
  "allowScripts": {
    "electron@45.3.4": true
  }
}
